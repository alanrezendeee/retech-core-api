# Copie para .env na raiz. O binário carrega .env automaticamente (ou use: -config / --config caminho).
# Obrigatórias (todas): DATABASE_URL, HTTP_ADDR, GIN_MODE, LOG_LEVEL — a API não sobe se faltar qualquer uma.
DATABASE_URL=postgres://retech_core:retech_core@localhost:5431/retech_core?sslmode=disable
HTTP_ADDR=:8001
GIN_MODE=debug
LOG_LEVEL=info
APP_PORT=8001

# Variáveis auxiliares PostgreSQL (usadas pelo docker-compose)
CONTAINER_NAME=retech-core-db
PGHOST=localhost
PGUSER=retech_core
PGPASSWORD=retech_core_dev_password
PGDATABASE=retech_core
PGPORT=5431
PGDATA=/var/lib/postgresql/data/pgdata
PGVOLUME_NAME=retech_core_db_volume
COMPOSE_NETWORK=retech-network